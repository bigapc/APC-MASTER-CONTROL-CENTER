# ─────────────────────────────────────────────────────────────────────────────
# APC Master Control Center — Environment Variables
# Copy this file to .env.local and fill in values.
# Never commit .env.local to source control.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ───────────────────────────────────────────────────────────────────────
# "demo" uses static data, no external connections required.
# "live" activates Supabase and disables all demo fallbacks.
NEXT_PUBLIC_DATA_MODE=demo

NEXT_PUBLIC_APP_NAME=APC_MASTER_CONTROL_CENTER

# Public-facing origin used for CORS (no trailing slash).
NEXT_PUBLIC_APP_ORIGIN=http://localhost:3000

# Secret used to sign APC session cookies. Generate a long random value.
APC_SESSION_SECRET=replace_with_a_long_random_secret

# ── Feature flags ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SAFE_CONNECT_ENABLED=true
NEXT_PUBLIC_COMMUNITY_SAFE_CONNECT_ENABLED=true
NEXT_PUBLIC_CSC20_ENABLED=true

# ── GitHub API ────────────────────────────────────────────────────────────────
# Personal Access Token with repo:read scope.
# Without this the GitHub page shows "unknown" status gracefully.
GITHUB_TOKEN=

# Optional shared rate-limit store for production login throttling.
# If omitted, APC falls back to per-instance in-memory buckets.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ── Supabase ──────────────────────────────────────────────────────────────────
# Required only when NEXT_PUBLIC_DATA_MODE=live.
# Run sql/apc_phase9_schema.sql in the Supabase SQL editor first.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — never expose to the browser (no NEXT_PUBLIC_ prefix).
SUPABASE_SERVICE_ROLE_KEY=

# Optional app links. Add real URLs later.
NEXT_PUBLIC_SAFECONNECT_PUBLIC_URL=
NEXT_PUBLIC_SAFECONNECT_ADMIN_URL=
NEXT_PUBLIC_COMMUNITYSAFECONNECT_PUBLIC_URL=
NEXT_PUBLIC_COMMUNITYSAFECONNECT_ADMIN_URL=
NEXT_PUBLIC_CSC_2_PUBLIC_URL=
NEXT_PUBLIC_CSC_2_ADMIN_URL=

# Optional future Mapbox live dispatch map token.
NEXT_PUBLIC_MAPBOX_TOKEN=
